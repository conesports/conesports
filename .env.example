# Supabase Postgres — Project Settings → Database → Connect
# Runtime queries: Transaction pooler (:6543)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: Session / direct connection (:5432)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (optional — leave blank to hide until configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin seed — npm run db:seed-admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Supabase Storage (used in later phases)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Payments — Paystack (NG / domestic; also editable in Admin → Settings)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
NEXT_PUBLIC_NGN_PER_USD="1600"

# Payments — Flutterwave (international; also editable in Admin → Settings)
FLUTTERWAVE_SECRET_KEY=""
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_HASH=""

# Resend (order + contact emails; also editable in Admin → Settings → Email)
RESEND_API_KEY=""
EMAIL_FROM="ConeSports <orders@example.com>"

# Optional: distributed rate limits. If unset, in-memory limits are used (single instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (leave blank locally). Create a Next.js project in Sentry and paste the DSN.
# Alerting: in Sentry, add an Issue Alert for new issues + a metric alert on error rate,
# and point an uptime monitor at /api/health.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
